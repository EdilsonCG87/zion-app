*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Arial, Helvetica, sans-serif;
}

body{
  background:#0b1120;
  color:white;
  padding:40px;
}

.app-container{
  max-width:1200px;
  margin:auto;
}

/* HEADER */

.header{
  display:flex;
  align-items:center;
  gap:20px;
  margin-bottom:30px;
  background:#111827;
  padding:20px;
  border-radius:15px;
  border:1px solid #1f2937;
  box-shadow:0 0 20px rgba(0,0,0,0.4);
}

.logo{
  width:90px;
  filter:drop-shadow(0px 0px 10px rgba(212,175,55,0.5));
}

.header h1{
  color:#d4af37;
  font-size:32px;
}

.header p{
  color:#9ca3af;
  margin-top:5px;
}

/* BUSCADOR */

.search-container{
  position:relative;
  width:60%;
  margin:0 auto 25px auto;
}

.search-input{
  width:100%;
  padding:14px 14px 14px 45px;
  border-radius:15px;
  border:1px solid rgba(255,255,255,0.2);
  background:rgba(255,255,255,0.08);
  backdrop-filter:blur(10px);
  color:white;
  font-size:15px;
  outline:none;
  transition:0.3s;
}

.search-input::placeholder{
  color:rgba(255,255,255,0.7);
}

.search-input:focus{
  border:1px solid #d4af37;
  box-shadow:0 0 10px rgba(212,175,55,0.4);
}

.search-icon{
  position:absolute;
  left:15px;
  top:50%;
  transform:translateY(-50%);
}

/* FORMULARIO */

.form-container{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
  gap:15px;
  margin-bottom:30px;
  background:#111827;
  padding:25px;
  border-radius:15px;
}

.form-container input{
  padding:12px;
  border:none;
  border-radius:10px;
  background:#1f2937;
  color:white;
}

.form-container input:focus{
  outline:none;
  border:2px solid #d4af37;
}

.save-btn{
  background:#d4af37;
  color:black;
  border:none;
  border-radius:10px;
  cursor:pointer;
  font-weight:bold;
  transition:0.3s;
}

.save-btn:hover{
  transform:scale(1.03);
}

/* TABLA */

table{
  width:100%;
  border-collapse:collapse;
  background:#111827;
  border-radius:15px;
  overflow:hidden;
}

thead{
  background:#d4af37;
  color:black;
}

th{
  padding:15px;
  text-align:left;
}

td{
  padding:15px;
  border-bottom:1px solid #1f2937;
}

tr:hover{
  background:#1f2937;
}

/* BOTONES */

.edit-btn,
.delete-btn{
  border:none;
  padding:10px 15px;
  border-radius:8px;
  color:white;
  cursor:pointer;
  font-weight:bold;
  margin-right:10px;
  transition:0.3s;
}

.edit-btn{
  background:#2563eb;
}

.edit-btn:hover{
  background:#1d4ed8;
}

.delete-btn{
  background:#dc2626;
}

.delete-btn:hover{
  background:#b91c1c;
}

.favorite-btn{
  border:none;
  padding:10px 14px;
  border-radius:8px;
  cursor:pointer;
  font-weight:bold;
  margin-right:10px;
  transition:0.3s;
  background:#374151;
  color:white;
}

.favorite-btn:hover{
  transform:scale(1.05);
}

.favorite-btn.active{
  background:#d4af37;
  color:black;
  box-shadow:0 0 10px rgba(212,175,55,0.6);
}

/* =========================
   ORDEN DEL CULTO MODERNO
========================= */

.playlist-card {
  background: #08152e;
  border-radius: 20px;
  padding: 30px;
  margin-top: 30px;
  box-shadow: 0 0 20px rgba(0,0,0,0.25);
}

.playlist-title {
  color: #f4c430;
  margin-bottom: 25px;
  text-align: center;
}

.playlist-row {
  display: flex;
  gap: 15px;
  margin-bottom: 20px;
}

.playlist-row input,
.playlist-row select {
  flex: 1;
  padding: 14px;
  border-radius: 12px;
  border: none;
  background: #152544;
  color: white;
  font-size: 15px;
}

.playlist-row input::placeholder {
  color: #bbb;
}

.pdf-btn {
  width: 100%;
}

/* BOTONES ORDEN DEL CULTO */

.playlist-card .save-btn {
  font-size: 14px;
  padding: 12px 18px;
  white-space: nowrap;
}

.stats-container {

  display: flex;

  gap: 20px;

  margin: 20px 0;

  flex-wrap: wrap;
}

.stat-card {

  flex: 1;

  min-width: 220px;

  background: #111827;

  border-radius: 15px;

  padding: 20px;

  text-align: center;

  color: white;

  box-shadow:
    0 0 15px
    rgba(0,0,0,.3);
}

.stat-card h3 {

  color: #d4af37;

  margin-bottom: 10px;
}

.stat-card h2 {

  font-size: 30px;

  margin: 0;
}

.top-song-item {

  margin-bottom: 15px;
}

.top-song-header {

  display: flex;

  justify-content: space-between;

  margin-bottom: 5px;

  color: white;
}

.top-song-bar {

  width: 100%;

  height: 10px;

  background: #1f2937;

  border-radius: 10px;

  overflow: hidden;
}

.top-song-fill {

  height: 100%;

  background: #d4af37;

  border-radius: 10px;
}
.agenda-container {

  display: flex;
  flex-direction: column;
  gap: 15px;

}

.agenda-card {

  display: flex;
  align-items: center;

  background: rgba(
    255,
    255,
    255,
    0.08
  );

  border-radius: 12px;

  padding: 15px;

  transition: 0.3s;

}

.agenda-card:hover {

  transform: translateY(-2px);

}

.agenda-date {

  width: 70px;

  text-align: center;

  margin-right: 20px;

}

.agenda-day {

  display: block;

  font-size: 28px;

  font-weight: bold;

  color: #4da6ff;

}

.agenda-month {

  display: block;

  font-size: 14px;

  color: #ccc;

}

.agenda-info h3 {

  margin: 0;

  color: white;

}

.agenda-info p {

  margin-top: 5px;

  color: #ccc;

}
.action-btn {
  border: none;
  border-radius: 12px;
  padding: 12px 18px;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.action-btn:hover {
  transform: translateY(-2px);
}

/* Crear */
.btn-create {
  background: #80f0a9;
  color: white;
}

/* Editar */
.btn-edit {
  background: #3b82f6;
  color: white;
}

/* Eliminar */
.btn-delete {
  background: #ef4444;
  color: white;
}

/* PDF */
.btn-pdf {
  background: #e7ab42;
  color: white;
}

/* WhatsApp */
.btn-whatsapp {
  background: #25d366;
  color: white;
}


.playlist-card {
  background: linear-gradient(
    145deg,
    #071a3d,
    #0a224f
  );

  border-radius: 20px;

  padding: 25px;

  margin-bottom: 25px;

  border: 1px solid rgba(
    255,
    255,
    255,
    0.05
  );

  box-shadow:
    0 10px 25px rgba(
      0,
      0,
      0,
      0.3
    );
}

.playlist-title {

  color: #f8d24b;

  font-size: 22px;

  font-weight: 700;

  display: flex;

  align-items: center;

  gap: 10px;

  margin-bottom: 20px;
}

input,
select {

  background: #102856;

  border: 1px solid transparent;

  border-radius: 14px;

  color: white;

  padding: 12px;

  transition: 0.3s;
}

input:focus,
select:focus {

  border-color: #f8d24b;

  outline: none;

  box-shadow:
    0 0 12px rgba(
      248,
      210,
      75,
      0.3
    );
}

.bottom-nav {

  position: fixed;

  bottom: 0;

  left: 0;

  width: 100%;

  height: 70px;

  background: #071a3d;

  display: flex;

  justify-content: space-around;

  align-items: center;

  border-top:
    1px solid rgba(
      255,
      255,
      255,
      0.1
    );

  z-index: 999;
}

.bottom-nav button {

  background: none;

  border: none;

  color: white;

  display: flex;

  flex-direction: column;

  align-items: center;

  gap: 4px;

  cursor: pointer;

  font-size: 18px;
}

.bottom-nav span {

  font-size: 11px;
}
.nav-btn{
  background: transparent;
  border: none;
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 3px;
  cursor: pointer;
  transition: all 0.3s ease;
}

.nav-btn.active{
  color: #ffd54f;
  transform: translateY(-3px);
}

.nav-btn.active span{
  font-weight: bold;
}
/* ==========================
   ANIMACIÓN DE PESTAÑAS
========================== */

.tab-content {
 animation: fadeSlide 0.45s cubic-bezier(.17,.67,.25,1);
}

@keyframes fadeSlide {

  from {
    opacity: 0;
    transform: translateY(15px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}
.calendar-card{

  background:#0b2458;

  padding:20px;

  border-radius:20px;

  margin-top:20px;

}

.calendar-grid{
    display:grid;
    grid-template-columns: repeat(7, 70px);
    gap:12px;
    justify-content:center;
    margin-top:20px;
}

.calendar-day{
    width:70px;
    height:70px;

    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;

    background:#17336f;
    border-radius:15px;

    color:white;
    font-weight:bold;

    cursor:pointer;

    transition:all .3s ease;
}

.service-dot{
  margin-top:5px;
  font-size:18px;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}

.calendar-header button{
    width:45px;
    height:45px;
    border:none;
    border-radius:12px;
    background:#57c84d;
    color:white;
    font-size:20px;
    font-weight:bold;
    cursor:pointer;
}

.calendar-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.calendar-legend{
    display:flex;
    justify-content:center;
    gap:30px;
    margin-top:25px;
    color:white;
}

.today{
    border:3px solid #FFD700;
    box-shadow:0 0 15px rgba(255,215,0,.6);
}

.calendar-day{
    cursor:pointer;
    transition:0.3s;
}

.calendar-day:hover{
    transform:scale(1.08);
    box-shadow:0 0 15px rgba(255,255,255,.25);
}

.selected-service-card{
    margin-top:20px;
    background:#1e293b;
    padding:15px;
    border-radius:15px;
    text-align:center;
    color:white;
}

.calendar-grid{
    display:grid;
    grid-template-columns:repeat(7,70px);
    gap:12px;
    justify-content:center;
    margin-top:20px;
}

.calendar-day{
    min-height:70px;
}
.calendar-weekday{
    text-align:center;
    font-weight:bold;
    color:#ffffff;
    font-size:18px;
}

.notification-card{

background:#1f2937;
border-left:5px solid #facc15;
padding:15px;
margin-bottom:20px;
border-radius:10px;
color:white;
font-weight:bold;

}

.next-service-alert{
  background:#1e88e5;
  color:white;
  padding:12px;
  margin:15px 0;
  border-radius:12px;
  text-align:center;
  font-weight:600;
  animation:pulse 2s infinite;
}

@keyframes pulse{
  0%{
    transform:scale(1);
  }

  50%{
    transform:scale(1.02);
  }

  100%{
    transform:scale(1);
  }
}

.notification-card {

  background: #1e293b;

  color: white;

  padding: 12px;

  margin: 15px;

  border-radius: 10px;

  text-align: center;

  font-weight: bold;

  border-left: 5px solid #facc15;

}



/*PRIMER CAMBIO DE DISEÑO 2026-08-14 */


/* =========================================================
   ZION - REDISEÑO VISUAL 15.1
   ORDEN DE CANCIONES DEL CULTO
   ========================================================= */

/* Contenedor general de cada fila */
.playlist-card .playlist-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
}

/* Cuando la fila contiene una canción */
.playlist-card .playlist-row > span {
    flex: 1;
    min-width: 0;

    display: flex;
    align-items: center;

    color: #ffffff;
    font-size: 16px;
    line-height: 1.4;
}

/* Número de la canción */
.playlist-card .playlist-row > span strong {
    min-width: 28px;
    color: #f8d24b;
}

/* Contenedor de botones de cada canción */
.playlist-card .playlist-row > div {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;

    flex-shrink: 0;
}

/* Botones subir / bajar / eliminar */
.playlist-card .action-btn {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: none;
    border-radius: 10px;

    font-size: 16px;
    font-weight: 700;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        opacity 0.2s ease,
        box-shadow 0.2s ease;
}

/* Efecto al pasar el mouse */
.playlist-card .action-btn:hover {
    transform: translateY(-2px);
}

/* Botón deshabilitado */
.playlist-card .action-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none;
}

/* Fila de canción */
.playlist-card .playlist-row:has(> span) {
    min-height: 58px;

    padding: 8px 12px;

    background: rgba(255, 255, 255, 0.035);

    border: 1px solid rgba(255, 255, 255, 0.06);

    border-radius: 12px;

    transition:
        background 0.2s ease,
        border-color 0.2s ease;
}

/* Efecto al pasar por una canción */
.playlist-card .playlist-row:has(> span):hover {
    background: rgba(255, 255, 255, 0.07);

    border-color: rgba(248, 210, 75, 0.25);
}


/* =========================================================
   MEJORA DEL TÍTULO "CANCIONES DEL CULTO"
   ========================================================= */

.playlist-title {
    font-size: 22px;
    font-weight: 700;
    letter-spacing: 0.2px;
}


/* =========================================================
   MEJORA GENERAL DE LAS TARJETAS
   ========================================================= */

.playlist-card {
    overflow: hidden;
}


/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 768px) {

    .playlist-card {
        padding: 20px;
    }

    .playlist-card .playlist-row:has(> span) {
        padding: 8px 10px;
    }

    .playlist-card .playlist-row > span {
        font-size: 15px;
    }

    .playlist-card .action-btn {
        width: 38px;
        height: 38px;
    }

}


/* =========================================================
   RESPONSIVE - CELULAR
   ========================================================= */

@media (max-width: 600px) {

    body {
        padding: 15px;
        padding-bottom: 90px;
    }

    .app-container {
        width: 100%;
    }

    .playlist-card {
        padding: 16px;
        border-radius: 16px;
    }

    .playlist-title {
        font-size: 19px;
        margin-bottom: 16px;
    }

    /* Las canciones siguen en una sola línea */
    .playlist-card .playlist-row:has(> span) {
        gap: 8px;
        padding: 7px 8px;
    }

    .playlist-card .playlist-row > span {
        font-size: 14px;
    }

    .playlist-card .playlist-row > div {
        gap: 5px;
    }

    .playlist-card .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        font-size: 14px;
    }

}


/*SEGUNDO CAMBIO DE DISEÑO 
2026-08-14*/



/* =========================================================
   ZION - REDISEÑO VISUAL 15.2
   GESTIÓN DE CULTOS
   ========================================================= */

/* ---------------------------------------------------------
   FILAS DEL FORMULARIO DE CULTOS
   --------------------------------------------------------- */

.playlist-card .playlist-row {
    align-items: stretch;
}

/* Inputs y selects del administrador de cultos */
.playlist-card .playlist-row input,
.playlist-card .playlist-row select {
    min-height: 48px;
    font-size: 15px;
}

/* ---------------------------------------------------------
   BOTONES PRINCIPALES
   --------------------------------------------------------- */

.playlist-card .save-btn,
.playlist-card .btn-create {
    min-height: 48px;

    padding: 0 22px;

    border-radius: 12px;

    font-size: 15px;
    font-weight: 700;

    white-space: nowrap;

    display: flex;
    align-items: center;
    justify-content: center;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        filter 0.2s ease;
}

.playlist-card .save-btn:hover,
.playlist-card .btn-create:hover {
    transform: translateY(-2px);

    box-shadow:
        0 6px 15px rgba(0, 0, 0, 0.25);

    filter: brightness(1.05);
}

.playlist-card .save-btn:active,
.playlist-card .btn-create:active {
    transform: translateY(0);
}


/* ---------------------------------------------------------
   SELECTOR DEL CULTO
   --------------------------------------------------------- */

.playlist-card select {
    cursor: pointer;
}

.playlist-card select:hover {
    border-color: rgba(248, 210, 75, 0.35);
}


/* ---------------------------------------------------------
   BOTONES DEL CULTO ACTIVO
   --------------------------------------------------------- */

.playlist-card .action-btn {
    min-height: 44px;
}


/* Botón editar */
.playlist-card .btn-edit {
    background: #3b82f6;
}

.playlist-card .btn-edit:hover {
    background: #2563eb;
    box-shadow: 0 5px 12px rgba(37, 99, 235, 0.3);
}


/* Botón eliminar */
.playlist-card .btn-delete {
    background: #ef4444;
}

.playlist-card .btn-delete:hover {
    background: #dc2626;
    box-shadow: 0 5px 12px rgba(239, 68, 68, 0.3);
}


/* PDF */
.playlist-card .btn-pdf {
    background: #e7ab42;
}

.playlist-card .btn-pdf:hover {
    background: #d99a2f;
    box-shadow: 0 5px 12px rgba(231, 171, 66, 0.3);
}


/* WhatsApp */
.playlist-card .btn-whatsapp {
    background: #25d366;
}

.playlist-card .btn-whatsapp:hover {
    background: #1ebe5d;
    box-shadow: 0 5px 12px rgba(37, 211, 102, 0.3);
}


/* ---------------------------------------------------------
   GRUPO DE BOTONES DEL CULTO ACTIVO
   --------------------------------------------------------- */

.playlist-card .active-playlist-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 15px;
}


/* ---------------------------------------------------------
   SEPARACIÓN VISUAL DEL SELECTOR
   --------------------------------------------------------- */

.playlist-card .playlist-row + .playlist-row {
    margin-top: 4px;
}


/* ---------------------------------------------------------
   ESTADO DE ENFOQUE
   --------------------------------------------------------- */

.playlist-card input:focus,
.playlist-card select:focus {
    transform: translateY(-1px);
}


/* =========================================================
   RESPONSIVE - TABLET
   ========================================================= */

@media (max-width: 768px) {

    .playlist-card .playlist-row {
        gap: 10px;
    }

    .playlist-card .playlist-row input,
    .playlist-card .playlist-row select {
        min-height: 46px;
    }

    .playlist-card .save-btn,
    .playlist-card .btn-create {
        padding: 0 16px;
        font-size: 14px;
    }

}


/* =========================================================
   RESPONSIVE - CELULAR
   ========================================================= */

@media (max-width: 600px) {

    /* Los elementos del formulario pasan a columna */
    .playlist-card .playlist-row {
        flex-direction: column;
        gap: 10px;
    }

    .playlist-card .playlist-row input,
    .playlist-card .playlist-row select,
    .playlist-card .playlist-row .save-btn,
    .playlist-card .playlist-row .btn-create {
        width: 100%;
        min-height: 46px;
    }

    /* Botones del culto activo */
    .playlist-card .active-playlist-actions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
    }

    .playlist-card .active-playlist-actions .action-btn {
        width: 100%;
    }

}


/* TERCER CAMBIO DE DISEÑO  2026-08-14*/


/* =========================================================
   BOTONES UNIFORMES - ZION PLAYLIST
   ========================================================= */

/* Contenedor de botones del culto activo */
.playlist-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 15px;
}


/* Botones principales */
.playlist-actions .action-btn {
    min-width: 105px;
    height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 16px;

    border: none;
    border-radius: 10px;

    font-size: 14px;
    font-weight: 600;

    white-space: nowrap;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        filter 0.2s ease;
}


/* Efecto al pasar el mouse */
.playlist-actions .action-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
}


/* =========================================================
   BOTONES DE CADA CANCIÓN
   ========================================================= */

.song-actions {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    min-width: 125px;
}


/* Botones subir / bajar */
.song-actions .action-btn {
    width: 38px;
    height: 38px;

    padding: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    font-size: 16px;
}


/* Botón eliminar */
.song-actions .btn-delete {
    width: 42px;
    height: 42px;

    padding: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;
}


/* =========================================================
   BOTONES DEL FORMULARIO
   ========================================================= */

.playlist-card .save-btn {
    min-width: 145px;
    height: 44px;

    padding: 0 18px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    font-size: 14px;
    font-weight: 700;

    white-space: nowrap;
}


/* =========================================================
   BOTÓN CREAR CULTO
   ========================================================= */

.btn-create {
    min-width: 145px;
    height: 44px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 18px;

    border-radius: 10px;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 600px) {

    .playlist-actions {
        width: 100%;
        gap: 8px;
    }

    .playlist-actions .action-btn {
        min-width: 0;
        flex: 1;
        height: 42px;
        padding: 0 10px;
        font-size: 13px;
    }

    .song-actions {
        min-width: auto;
        gap: 6px;
    }

    .song-actions .action-btn {
        width: 36px;
        height: 36px;
    }

    .song-actions .btn-delete {
        width: 38px;
        height: 38px;
    }

}

/* cuarta actualizacion de diseño 2026-08-14*/

/* =========================================
   BOTONES CULTO ACTIVO
   ========================================= */

.active-playlist-actions {
    display: flex;
    gap: 12px;
    margin-top: 15px;
    flex-wrap: wrap;
    align-items: center;
}

/* Todos los botones tienen exactamente
   el mismo tamaño */

.active-playlist-actions .action-btn {
    width: 130px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 7px;

    padding: 0;

    border: none;
    border-radius: 12px;

    color: white;
    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        filter 0.2s ease,
        box-shadow 0.2s ease;
}

/* Icono */

.active-playlist-actions .action-btn span {
    white-space: nowrap;
}

/* Hover */

.active-playlist-actions .action-btn:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
}

/* Click */

.active-playlist-actions .action-btn:active {
    transform: translateY(0);
}

/* =========================================
   COLORES
   ========================================= */

.active-playlist-actions .btn-edit {
    background: #3b82f6;
}

.active-playlist-actions .btn-delete {
    background: #ef4444;
}

.active-playlist-actions .btn-pdf {
    background: #e7ab42;
}

.active-playlist-actions .btn-whatsapp {
    background: #25d366;
}


/* =========================================
   TABLETS
   ========================================= */

@media (max-width: 768px) {

    .active-playlist-actions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .active-playlist-actions .action-btn {
        width: 100%;
    }

}


/* =========================================
   MÓVILES
   ========================================= */

@media (max-width: 480px) {

    .active-playlist-actions {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .active-playlist-actions .action-btn {
        height: 44px;
        font-size: 13px;
        border-radius: 10px;
    }

}

/* QUINTA ACTUALIZACIÓN DE DISEÑO 2026-08-14 */


/* =========================================
   RESPONSIVE - TABLETS Y CELULARES
   ========================================= */

/* TABLETS */
@media (max-width: 768px) {

    body {
        padding: 20px;
    }

    .app-container {
        width: 100%;
        max-width: 100%;
    }

    /* HEADER */

    .header {
        padding: 18px;
        gap: 15px;
    }

    .logo {
        width: 75px;
    }

    .header h1 {
        font-size: 27px;
    }

    .header p {
        font-size: 14px;
    }

    /* TARJETAS */

    .playlist-card {
        padding: 20px;
        margin-top: 20px;
    }

    /* FILAS */

    .playlist-row {
        flex-direction: column;
        gap: 10px;
    }

    .playlist-row input,
    .playlist-row select {
        width: 100%;
    }

    /* BOTONES */

    .action-btn {
        min-height: 44px;
    }

    /* CALENDARIO */

    .calendar-grid {
        width: 100%;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 8px;
        justify-content: stretch;
    }

    .calendar-day {
        width: 100%;
        min-width: 0;
        min-height: 60px;
        height: auto;
    }

}

/* sexta actualizacion de diseño 2026-08-14 */

/* =========================================
   CELULARES
   ========================================= */

@media (max-width: 480px) {

    body {
        padding: 10px;
        padding-bottom: 85px;
    }

    .app-container {
        width: 100%;
    }

    /* HEADER */

    .header {
        flex-direction: row;
        padding: 15px;
        gap: 12px;
    }

    .logo {
        width: 75px;
        flex-shrink: 0;
    }

    .header h1 {
        font-size: 25px;
        line-height: 1.15;
    }

    .header p {
        font-size: 14px;
        line-height: 1.4;
    }

    /* TARJETAS */

    .playlist-card {
        padding: 16px;
        border-radius: 16px;
        margin-top: 15px;
    }

    .playlist-title {
        font-size: 20px;
        margin-bottom: 15px;
    }

    /* FORMULARIOS */

    .playlist-row {
        flex-direction: column;
        gap: 10px;
        margin-bottom: 12px;
    }

    .playlist-row input,
    .playlist-row select {
        width: 100%;
        min-height: 48px;
    }

    /* BOTONES */

    .action-btn {
        width: 100%;
        min-height: 44px;
        padding: 10px 12px;
    }

    /* CALENDARIO */

    .calendar-card {
        padding: 12px;
        border-radius: 16px;
    }

    .calendar-header {
        gap: 8px;
    }

    .calendar-header button {
        width: 42px;
        height: 42px;
        flex-shrink: 0;
    }

    .calendar-grid {
        width: 100%;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 5px;
        margin-top: 15px;
    }

    .calendar-weekday {
        font-size: 13px;
    }

    .calendar-day {
        width: 100%;
        min-width: 0;
        min-height: 52px;
        height: 52px;
        border-radius: 10px;
        font-size: 14px;
    }

    .service-dot {
        margin-top: 2px;
        font-size: 14px;
    }

    /* LEYENDA */

    .calendar-legend {
        gap: 12px;
        flex-wrap: wrap;
        font-size: 13px;
    }

    /* NAVEGACIÓN INFERIOR */

    .bottom-nav {
        height: 70px;
    }

}


/*ACTUALIZACION DE DISEÑO 2026-08-15*/

/* =========================================
   15.3 - BIBLIOTECA RESPONSIVE
   ========================================= */

/* CONTENEDOR DE LA TABLA */

.songs-table-container {
    width: 100%;
    overflow-x: auto;
    margin-top: 20px;
    border-radius: 15px;
}


/* TABLA */

.songs-table {
    width: 100%;
    min-width: 700px;
}


/* COLUMNA DE ACCIONES */

.song-actions {
    white-space: nowrap;
}


/* =========================================
   TABLETS
   ========================================= */

@media (max-width: 768px) {

    .search-container {
        width: 90%;
    }

    .form-container {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .form-container .save-btn {
        min-height: 44px;
    }

    .songs-table th,
    .songs-table td {
        padding: 12px 10px;
        font-size: 14px;
    }

    .edit-btn,
    .delete-btn,
    .favorite-btn {
        padding: 9px 12px;
        margin-right: 5px;
    }

}


/* =========================================
   CELULARES
   ========================================= */

@media (max-width: 480px) {

    /* BUSCADOR */

    .search-container {
        width: 100%;
        margin-bottom: 20px;
    }

    .search-input {
        padding: 13px 12px 13px 42px;
        font-size: 14px;
    }


    /* FORMULARIO */

    .form-container {
        grid-template-columns: 1fr;
        padding: 18px;
        gap: 10px;
    }

    .form-container input {
        width: 100%;
        min-height: 44px;
    }

    .form-container .save-btn {
        width: 100%;
        min-height: 44px;
    }


    /* TABLA */

    .songs-table-container {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .songs-table {
        min-width: 680px;
    }

    .songs-table th,
    .songs-table td {
        padding: 10px;
        font-size: 13px;
    }


    /* BOTONES */

    .song-actions {
        white-space: nowrap;
    }

    .edit-btn,
    .delete-btn,
    .favorite-btn {
        padding: 8px 10px;
        font-size: 12px;
        margin-right: 4px;
    }

}


/*DISEÑO 15.4 - 2026-08-15*/

/* =========================================
   TOP CANCIONES
   ========================================= */

.top-songs-card {

    background: #111827;

    border-radius: 15px;

    padding: 20px;

    margin-top: 20px;

    box-shadow:
        0 0 15px rgba(0,0,0,.3);

}

.top-songs-title {

    color: #d4af37;

    margin: 0;

    cursor: pointer;

    display: flex;

    justify-content: space-between;

    align-items: center;

}

.top-songs-list {

    margin-top: 20px;

}

.top-songs-empty {

    margin-top: 20px;

    color: #9ca3af;

}

.top-song-item {

    margin-bottom: 15px;

}

.top-song-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;

    margin-bottom: 6px;

    color: white;

}

.top-song-header span:first-child {

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;

}

.top-song-bar {

    width: 100%;

    height: 10px;

    background: #1f2937;

    border-radius: 10px;

    overflow: hidden;

}

.top-song-fill {

    height: 100%;

    background: #d4af37;

    border-radius: 10px;

    transition: width .4s ease;

}


/* =========================================
   TOP CANCIONES - MÓVIL
   ========================================= */

@media (max-width: 480px) {

    .top-songs-card {

        padding: 16px;

    }

    .top-songs-title {

        font-size: 18px;

    }

    .top-song-header {

        font-size: 14px;

    }

}

/*AJUSTE DE CANCIONES 2026-08-16*/

/* =========================
   DETALLE DE CANCIÓN
========================= */

.song-detail-card {

    margin-top: 30px;
    padding: 24px;

    background: #0f1a2d;

    border-radius: 18px;

    border: 1px solid rgba(255, 255, 255, 0.08);

    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.20);

}


/* =========================
   ENCABEZADO
========================= */

.song-detail-header {

    display: flex;

    justify-content: space-between;

    align-items: flex-start;

    gap: 15px;

    margin-bottom: 22px;

}


.song-detail-header h3 {

    margin: 0 0 8px;

    color: #ffd43b;

}


.song-detail-header h2 {

    margin: 0;

    color: white;

}


/* =========================
   CERRAR
========================= */

.song-detail-close {

    width: 40px;

    height: 40px;

    border: none;

    border-radius: 10px;

    background: #ef4444;

    color: white;

    font-size: 18px;

    cursor: pointer;

}


/* =========================
   INFORMACIÓN
========================= */

.song-detail-info {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 12px;

}


.song-detail-item {

    padding: 14px;

    background: #182944;

    border-radius: 12px;

}


.song-detail-item span {

    display: block;

    margin-bottom: 6px;

    color: #aebbd0;

    font-size: 14px;

}


.song-detail-item strong {

    color: white;

    font-size: 16px;

}


/* =========================
   HISTORIAL
========================= */

.song-history-section {

    margin-top: 28px;

    padding-top: 22px;

    border-top:
        1px solid
        rgba(255, 255, 255, 0.10);

}


.song-history-section h3 {

    margin-top: 0;

    color: #ffd43b;

}


.song-history-list {

    display: flex;

    flex-direction: column;

    gap: 10px;

}


.song-history-item {

    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 15px;

    padding: 14px 16px;

    background: #182944;

    border-radius: 10px;

    color: white;

}


.song-history-item strong {

    color: white;

}


.song-history-empty {

    color: #aebbd0;

    margin: 0;

}

/*VISTA CELULAR 2026-08-16*/

/* =========================
   MÓVILES
========================= */

@media (max-width: 600px) {

    .song-detail-card {

        margin-top: 24px;

        padding: 18px;

    }


    .song-detail-info {

        grid-template-columns: 1fr 1fr;

    }


    .song-history-item {

        flex-direction: column;

        align-items: flex-start;

    }

}

.users-page {
    padding-bottom: 100px;
}

.users-page-header,
.user-form,
.dialog-actions,
.user-actions {
    display: flex;
    gap: 12px;
}

.users-page-header {
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}

.users-page-header h2,
.users-card h3 {
    margin: 0 0 6px;
}

.users-page-header p {
    margin: 0;
    opacity: 0.75;
}

.users-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 20px;
    margin-bottom: 18px;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.08);
}

.user-form {
    flex-wrap: wrap;
}

.user-form input,
.user-form select,
.password-dialog input {
    min-width: 180px;
    flex: 1;
    padding: 11px 12px;
    border: 1px solid #d4d4d4;
    border-radius: 8px;
    font: inherit;
}

.primary-btn,
.secondary-btn,
.small-btn {
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    cursor: pointer;
    font: inherit;
}

.primary-btn {
    background: #4d8f35;
    color: white;
}

.secondary-btn,
.small-btn {
    background: #ececec;
    color: #333;
}

.danger-btn {
    background: #d94b4b;
    color: white;
}

.users-table-wrapper {
    overflow-x: auto;
}

.users-table {
    width: 100%;
    border-collapse: collapse;
}

.users-table th,
.users-table td {
    padding: 12px;
    text-align: left;
    border-bottom: 1px solid #eeeeee;
}

.role-badge,
.status-badge {
    display: inline-block;
    border-radius: 999px;
    padding: 4px 9px;
    font-size: 0.85rem;
    font-weight: 600;
}

.role-badge {
    background: #e8e2ff;
    color: #5435a6;
}

.status-badge.enabled {
    background: #dcf7e2;
    color: #237538;
}

.status-badge.disabled {
    background: #fde1e1;
    color: #ad2929;
}

.users-message {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 16px;
}

.users-message button {
    border: none;
    background: transparent;
    font-size: 20px;
    cursor: pointer;
}

.users-message.error {
    background: #fde3e3;
    color: #982d2d;
}

.users-message.success {
    background: #def4e3;
    color: #28733a;
}

.users-empty {
    color: #777;
}

.password-overlay {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.48);
}

.password-dialog {
    width: min(420px, 100%);
    background: white;
    border-radius: 14px;
    padding: 22px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
}

.password-dialog h3 {
    margin-top: 0;
}

.password-dialog input {
    width: 100%;
    box-sizing: border-box;
}

.dialog-actions {
    justify-content: flex-end;
    margin-top: 16px;
}

@media (max-width: 700px) {
    .users-page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .user-form {
        flex-direction: column;
    }

    .user-form input,
    .user-form select,
    .user-form button {
        width: 100%;
        box-sizing: border-box;
    }

    .user-actions {
        flex-wrap: wrap;
    }
}

/* =========================
   ADMINISTRACIÓN DE USUARIOS
   ========================= */

.users-admin {
    width: min(100%, 1000px);
    margin: 28px auto 110px;
    color: #f4f7ff;
}

.users-hero,
.users-create-card,
.users-list-card {
    box-sizing: border-box;
    border: 1px solid #253149;
    border-radius: 18px;
    background: #111a2b;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.16);
}

.users-hero {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 26px 30px;
    margin-bottom: 20px;
    background:
        radial-gradient(circle at top right, rgba(226, 188, 52, 0.15), transparent 34%),
        #111a2b;
}

.users-eyebrow {
    margin: 0 0 7px;
    color: #e2bc34;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
}

.users-hero h2,
.users-card-heading h3,
.users-list-heading h3,
.users-password-modal h3 {
    margin: 0;
    color: #ffffff;
}

.users-hero h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
}

.users-subtitle,
.users-card-heading p,
.users-list-heading p,
.users-password-modal > p {
    margin: 7px 0 0;
    color: #aebbd1;
}

.users-refresh-button,
.users-create-button,
.users-action-button,
.users-delete-button,
.users-cancel-button {
    border: none;
    border-radius: 9px;
    padding: 11px 15px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
    transition: transform 0.18s ease, filter 0.18s ease;
}

.users-refresh-button:hover,
.users-create-button:hover,
.users-action-button:hover,
.users-delete-button:hover,
.users-cancel-button:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
}

.users-refresh-button {
    flex-shrink: 0;
    background: #1d2c46;
    color: #ffffff;
}

.users-create-card {
    padding: 25px 28px;
    margin-bottom: 20px;
}

.users-card-heading {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
}

.users-heading-icon {
    display: grid;
    width: 37px;
    height: 37px;
    place-items: center;
    border-radius: 10px;
    background: rgba(226, 188, 52, 0.15);
    color: #e2bc34;
    font-size: 1.5rem;
    font-weight: 600;
}

.users-form {
    display: grid;
    grid-template-columns: 1.4fr 1.4fr 0.8fr auto;
    align-items: end;
    gap: 14px;
}

.users-form label,
.users-password-modal label {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.users-form label span,
.users-password-modal label span {
    color: #c2cde0;
    font-size: 0.84rem;
    font-weight: 700;
}

.users-form input,
.users-form select,
.users-password-modal input {
    min-width: 0;
    box-sizing: border-box;
    width: 100%;
    border: 1px solid #31405a;
    border-radius: 9px;
    outline: none;
    padding: 12px 13px;
    background: #172440;
    color: #ffffff;
    font: inherit;
}

.users-form input::placeholder,
.users-password-modal input::placeholder {
    color: #8291ab;
}

.users-form input:focus,
.users-form select:focus,
.users-password-modal input:focus {
    border-color: #e2bc34;
    box-shadow: 0 0 0 3px rgba(226, 188, 52, 0.12);
}

.users-create-button {
    background: #dfb92f;
    color: #172033;
}

.users-list-card {
    overflow: hidden;
}

.users-list-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 23px 28px;
    border-bottom: 1px solid #253149;
}

.users-count {
    display: grid;
    min-width: 34px;
    height: 34px;
    place-items: center;
    border-radius: 50%;
    background: rgba(226, 188, 52, 0.15);
    color: #e2bc34;
    font-weight: 800;
}

.users-table-wrapper {
    overflow-x: auto;
}

.users-table {
    width: 100%;
    min-width: 650px;
    border-collapse: collapse;
}

.users-table th {
    padding: 13px 28px;
    background: #1a2740;
    color: #d8e0ee;
    text-align: left;
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.users-table td {
    padding: 16px 28px;
    border-top: 1px solid #253149;
}

.users-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.025);
}

.users-person {
    display: flex;
    align-items: center;
    gap: 11px;
}

.users-person > span {
    display: grid;
    width: 33px;
    height: 33px;
    place-items: center;
    border-radius: 50%;
    background: #273b61;
    color: #f2cc43;
    font-weight: 800;
}

.users-role-badge,
.users-status {
    display: inline-block;
    border-radius: 999px;
    padding: 5px 10px;
    font-size: 0.8rem;
    font-weight: 800;
}

.users-role-badge {
    background: rgba(147, 112, 255, 0.17);
    color: #c7b3ff;
}

.users-status-active {
    background: rgba(72, 181, 110, 0.15);
    color: #71db91;
}

.users-status-inactive {
    background: rgba(232, 90, 90, 0.14);
    color: #ff9898;
}

.users-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
}

.users-actions-header {
    text-align: right !important;
}

.users-action-button {
    padding: 8px 10px;
    background: #223352;
    color: #dce6f7;
    font-size: 0.8rem;
}

.users-delete-button {
    padding: 8px 10px;
    background: rgba(220, 75, 75, 0.16);
    color: #ff9797;
    font-size: 0.8rem;
}

.users-empty,
.users-loading {
    padding: 48px 24px;
    color: #aebbd1;
    text-align: center;
}

.users-empty > div {
    margin-bottom: 8px;
    font-size: 2.2rem;
}

.users-empty h4 {
    margin: 0;
    color: #ffffff;
}

.users-empty p {
    margin: 8px 0 0;
}

.users-alert {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 18px;
    border-radius: 10px;
    padding: 13px 16px;
}

.users-alert-success {
    background: rgba(70, 179, 107, 0.16);
    color: #8be3a7;
}

.users-alert-error {
    background: rgba(220, 75, 75, 0.16);
    color: #ffadad;
}

.users-alert button {
    margin-left: auto;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 1.25rem;
    cursor: pointer;
}

.users-modal-overlay {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 20px;
    background: rgba(4, 9, 19, 0.72);
}

.users-password-modal {
    position: relative;
    width: min(100%, 410px);
    box-sizing: border-box;
    border: 1px solid #30405c;
    border-radius: 16px;
    padding: 28px;
    background: #111a2b;
    box-shadow: 0 20px 55px rgba(0, 0, 0, 0.36);
}

.users-modal-close {
    position: absolute;
    top: 12px;
    right: 14px;
    border: none;
    background: transparent;
    color: #aebbd1;
    font-size: 1.7rem;
    cursor: pointer;
}

.users-password-modal label {
    margin-top: 22px;
}

.users-modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 22px;
}

.users-cancel-button {
    background: #24324c;
    color: #dbe5f5;
}

@media (max-width: 760px) {
    .users-admin {
        margin-top: 18px;
    }

    .users-hero,
    .users-list-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .users-create-card,
    .users-list-heading {
        padding: 21px 18px;
    }

    .users-hero {
        padding: 22px 20px;
    }

    .users-form {
        grid-template-columns: 1fr;
    }

    .users-form .users-create-button {
        width: 100%;
    }

    .users-count {
        position: absolute;
        right: 20px;
    }
}